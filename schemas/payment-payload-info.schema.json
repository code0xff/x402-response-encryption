{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "response-encryption PaymentPayload info (v1)",
  "description": "The advertised PaymentRequired info echoed unchanged, plus the client's ephemeralPublicKey and nonceSalt (proposal 7.2).",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "required": {
      "type": "boolean"
    },
    "suite": {
      "const": "secp256k1-hkdf-sha256-aes256gcm"
    },
    "keyId": {
      "$ref": "#/$defs/bytes32"
    },
    "kid": {
      "description": "Optional. did:web profile only (proposal 4.5).",
      "type": "string",
      "pattern": "^did:web:[^#]+#x402-re-[0-9a-f]{64}$"
    },
    "publicKey": {
      "$ref": "#/$defs/compressedPoint"
    },
    "attestation": {
      "type": "object",
      "properties": {
        "payTo": {
          "$ref": "#/$defs/address"
        },
        "notBefore": {
          "$ref": "#/$defs/uint64"
        },
        "notAfter": {
          "$ref": "#/$defs/uint64"
        },
        "signature": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})+$"
        }
      },
      "required": [
        "payTo",
        "notBefore",
        "notAfter",
        "signature"
      ],
      "additionalProperties": false
    },
    "ephemeralPublicKey": {
      "$ref": "#/$defs/compressedPoint"
    },
    "nonceSalt": {
      "$ref": "#/$defs/bytes32"
    }
  },
  "required": [
    "version",
    "required",
    "suite",
    "keyId",
    "publicKey",
    "attestation",
    "ephemeralPublicKey",
    "nonceSalt"
  ],
  "additionalProperties": false,
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "compressedPoint": {
      "type": "string",
      "pattern": "^0x0[23][0-9a-fA-F]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
