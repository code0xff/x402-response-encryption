{
  "name": "@x402-response-encryption/core",
  "version": "0.1.0",
  "description": "Primitives for the x402 response-encryption extension: key binding, URL canonicalization, envelope encryption.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
