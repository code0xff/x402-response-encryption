  },
  "dependencies": {
    "@noble/ciphers": "0.5.3",
    "@noble/curves": "1.4.0",
    "@noble/hashes": "1.4.0",
    "viem": "2.57.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
